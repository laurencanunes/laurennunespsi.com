---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sobre · Lauren Nunes" description="Sobre Lauren Nunes, Psicóloga.">
  <article class="py-8">
    <h1 class="font-heading text-3xl font-bold text-brand-dark">Sobre</h1>

    <p class="mt-6 text-brand-dark/80">
      Parágrafo placeholder de apresentação. Substitua por uma breve biografia,
      abordagem terapêutica e formação.
    </p>

    <h2 class="mt-8 font-heading text-2xl font-semibold text-brand-dark">
      Abordagem
    </h2>
    <p class="mt-3 text-brand-dark/80">
      Texto placeholder descrevendo a abordagem e as áreas de atuação.
    </p>

    <h2 class="mt-8 font-heading text-2xl font-semibold text-brand-dark">
      Contato
    </h2>
    <p class="mt-3 text-brand-dark/80">
      Informações de contato placeholder — telefone, e-mail ou WhatsApp.
    </p>
  </article>
</BaseLayout>

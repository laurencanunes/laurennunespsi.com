---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../assets/dra-lauren-nunes.png";
import workspace from "../assets/lauren-psicologa-escritorio.png";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { GOOGLE_REVIEWS_URL, INSTAGRAM_URL, WHATSAPP_NUMBER } from "../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const dateFormat = new Intl.DateTimeFormat("pt-BR", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});

const credentials = [
  "Abordagem comportamental",
  "Atendimento para imigrantes",
  "Neurodivergentes",
  "Acompanhamento individualizado",
];

const demands = [
  {
    title: "TDAH em adultos",
    body: "Trabalhamos para o desenvolvimento de repertórios de organização, autorregulação e autocontrole, além do manejo da procrastinação, por meio da construção de estratégias práticas para demandas que geram sofrimento no cotidiano.",
    fill: "bg-brand-card-yellow",
  },
  {
    title: "Autismo (TEA)",
    body: "Auxilio adultos autistas e famílias a lidar com características do TEA, como rigidez comportamental, dificuldades de comunicação e interação social, regulação emocional e autonomia no cotidiano.",
    fill: "bg-brand-mint",
  },
  {
    title: "Imigração e adaptação",
    body: "Recomeçar em outra cultura, saudade, culpa e a sensação de não pertencer.",
    fill: "bg-brand-card-peach",
  },
  {
    title: "Autoestima e autoconfiança",
    body: "Rever a régua com que você se mede e a autocrítica que não dá trégua.",
    fill: "bg-brand-card-blue",
  },
  {
    title: "Ansiedade e estresse",
    body: "Mapear gatilhos, diminuir a evitação e retomar o que importa para você.",
    fill: "bg-brand-card-pink",
  },
  {
    title: "Orientação de pais",
    body: "Apoio prático baseado em ABA para pais e cuidadores no manejo de comportamento.",
    fill: "bg-brand-card-purple",
  },
];

const steps = [
  {
    title: "Você me escreve",
    body: "Uma mensagem no WhatsApp contando, brevemente, por qual motivo está buscando a psicoterapia.",
  },
  {
    title: "Agendamos uma conversa, ou bate-papo",
    body: "Encontramos um horário que caiba na sua rotina e no seu fuso horário.",
  },
  {
    title: "Bate-Papo",
    body: "Você me conta mais detalhadamente o que está acontecendo com você e eu te explico a forma como eu trabalho, sem custos. Se fizer sentido para você e se eu puder atender a sua demanda, agendamos o primeiro atendimento.",
  },
  {
    title: "Primeiro Atendimento",
    body: "Começamos a compreender sua história, rotina e o que você espera da terapia. Juntos, começamos a definir os primeiros objetivos do processo.",
  },
];

const pillars = [
  {
    title: "Evidência",
    body: "Técnicas com respaldo em pesquisa, adaptadas ao seu caso.",
  },
  {
    title: "Contexto",
    body: "Rotina, relações e ambiente entram na conta desde o início.",
  },
  {
    title: "Metas claras",
    body: "Você sabe o que estamos trabalhando e por quê, em cada etapa.",
  },
  {
    title: "Respeito",
    body: "Nenhuma intervenção que peça para você deixar de ser quem é.",
  },
];

const faqs = [
  {
    q: "Como sei se preciso de terapia?",
    a: "Não existe sofrimento mínimo para pedir ajuda. Se algo se repete, incomoda ou atrapalha sua rotina e suas relações, vale conversar. Na primeira sessão avaliamos juntas se faz sentido seguir.",
  },
  {
    q: "Terapia online funciona tão bem quanto presencial?",
    a: "Sim. A modalidade é reconhecida pelo Conselho Federal de Psicologia e tem boa base de pesquisa. Muda o formato; o vínculo, o sigilo e o método continuam os mesmos.",
  },
  {
    q: "Você atende brasileiros que moram fora?",
    a: "Sim, em português e com horário ajustado ao seu fuso. Adaptação cultural e luto migratório são temas frequentes no meu consultório.",
  },
  {
    q: "Como funciona o agendamento?",
    a: "Pelo WhatsApp. Você me escreve, eu te passo os horários disponíveis e as condições atuais, e reservamos a sessão. Frequência e duração são definidas caso a caso.",
  },
  {
    q: "O que eu contar fica em sigilo?",
    a: "Sim. Sigilo é dever ético do psicólogo e vale integralmente no atendimento online. As sessões acontecem em ambiente privado e não são gravadas.",
  },
  {
    q: "Preciso de diagnóstico para começar?",
    a: "Não. Muita gente chega justamente com dúvidas sobre o que está acontecendo. Trabalhamos a partir das suas queixas concretas, com ou sem diagnóstico.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Psychologist", "ProfessionalService"],
      "@id": "#lauren",
      name: "Lauren Nunes — Psicóloga",
      description:
        "Psicoterapia online em português com abordagem comportamental e Análise do Comportamento Aplicada (ABA), para adultos, adolescentes e famílias.",
      telephone: `+${WHATSAPP_NUMBER}`,
      areaServed: "Worldwide",
      availableLanguage: "pt-BR",
      knowsAbout: [
        "TDAH em adultos",
        "Transtorno do Espectro Autista",
        "Imigração e adaptação cultural",
        "Autoestima",
        "Ansiedade",
        "Orientação de pais",
        "Análise do Comportamento Aplicada",
      ],
      sameAs: [INSTAGRAM_URL],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
  ],
};

const eyebrow =
  "text-xs font-semibold uppercase tracking-[0.18em] text-brand-eyebrow";
const sectionTitle =
  "font-heading text-[38px] font-bold leading-[1.14] tracking-tight text-brand-dark";
---

<BaseLayout wide schema={schema}>
  <!-- Hero -->
  <section id="top" class="px-6 pb-16 pt-16 md:px-11 lg:pt-20">
    <div
      class="mx-auto grid max-w-content grid-cols-1 items-center gap-14 lg:grid-cols-2"
    >
      <div>
        <p
          class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-brand-eyebrow"
        >
          Psicoterapia online
        </p>
        <h1
          class="text-pretty font-heading text-hero font-bold text-brand-dark"
        >
          Cuidado psicológico que atravessa a distância, onde você estiver.
        </h1>
        <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-brand-body">
          Psicoterapia comportamental para adultos e famílias, por videochamada.
          Para quem vive no Brasil e para quem está recomeçando em outro país.
        </p>
        <div class="mt-8 flex flex-wrap gap-3.5">
          <WhatsAppButton>Conversar no WhatsApp</WhatsAppButton>
          <a
            href="#como-funciona"
            class="inline-flex min-h-[44px] items-center rounded-2xl border-[1.5px] border-brand-border-strong px-8 py-4 text-lg font-semibold text-brand-subtle transition-colors hover:border-brand-accent hover:text-brand-primary"
          >
            Como funciona
          </a>
        </div>
        <ul
          class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] text-brand-muted"
        >
          <li>Atendimento 100% online</li>
          <li aria-hidden="true" class="text-brand-border-strong">·</li>
          <li>Sessões em português</li>
          <li aria-hidden="true" class="text-brand-border-strong">·</li>
          <li>Horários flexíveis</li>
        </ul>
      </div>

      <div class="relative p-4">
        <div class="absolute inset-0 rounded-3xl bg-brand-mint"></div>
        <div
          class="absolute -bottom-7 -left-7 h-[150px] w-[150px] rounded-[20px] bg-brand-card-yellow"
        >
        </div>
        <Image
          src={profile}
          alt="Dra. Lauren Nunes, psicóloga."
          width={1080}
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          class="relative block h-[500px] w-full rounded-[18px] object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Credentials strip -->
  <div class="border-y border-brand-line">
    <ul
      class="mx-auto grid max-w-content grid-cols-1 gap-px bg-brand-line sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        credentials.map((item) => (
          <li class="bg-white px-8 py-6 text-sm font-medium text-brand-subtle">
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Sobre -->
  <section
    id="sobre"
    class="scroll-mt-20 border-t border-brand-line px-6 py-20 md:px-11"
  >
    <div
      class="mx-auto grid max-w-content grid-cols-1 items-start gap-14 lg:grid-cols-2"
    >
      <Image
        src={workspace}
        alt="Lauren Nunes em seu escritório, onde atende as sessões online."
        format="webp"
        quality={80}
        class="block h-[340px] w-full rounded-3xl object-cover"
      />
      <div>
        <p class={`mb-3.5 ${eyebrow}`}>Sobre mim</p>
        <h2
          class="mb-5 font-heading text-4xl font-bold leading-tight tracking-tight text-brand-dark"
        >
          Olá, eu sou a Lauren
        </h2>
        <div
          class="flex flex-col gap-3.5 text-[17px] leading-relaxed text-brand-body"
        >
          <p>
            Sou psicóloga clínica e trabalho com terapia comportamental e
            Análise do Comportamento Aplicada (ABA). Atendo adultos,
            adolescentes e famílias que querem entender o próprio funcionamento
            e construir mudanças que se sustentem no dia a dia.
          </p>
        </div>
        <!-- <a
        href="/sobre"
        class="mt-7 inline-flex items-center text-[15px] font-semibold text-brand-primary hover:text-brand-primary-hover"
      >
        Ler minha trajetória completa →
      </a> -->
      </div>
    </div>
  </section>

  <!-- Demandas -->
  <section
    id="demandas"
    class="scroll-mt-20 bg-brand-light px-6 py-20 md:px-11"
  >
    <div class="mx-auto max-w-content">
      <div class="mb-11 max-w-[640px]">
        <p class={`mb-3.5 ${eyebrow}`}>Demandas</p>
        <h2 class={`mb-3.5 ${sectionTitle}`}>
          Para o que as pessoas me procuram
        </h2>
        <p class="text-[17px] leading-relaxed text-brand-body">
          Você não precisa chegar com um nome para o que sente. Estes são os
          temas mais frequentes no consultório.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          demands.map((item) => (
            <article
              class:list={[
                "flex min-h-[196px] flex-col rounded-[20px] p-7",
                item.fill,
              ]}
            >
              <h3 class="mb-2.5 font-heading text-xl font-bold text-brand-dark">
                {item.title}
              </h3>
              <p class="text-[15px] leading-relaxed text-brand-subtle">
                {item.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Como funciona -->
  <section id="como-funciona" class="scroll-mt-20 px-6 py-20 md:px-11">
    <div class="mx-auto max-w-content">
      <div class="mb-11 max-w-[640px]">
        <p class={`mb-3.5 ${eyebrow}`}>Como funciona</p>
        <h2 class={`mb-3.5 ${sectionTitle}`}>
          Quatro passos até a primeira sessão
        </h2>
        <p class="text-[17px] leading-relaxed text-brand-body">
          Combinamos tudo por mensagem: horário, formato e condições. Sem
          formulários longos.
        </p>
      </div>
      <ol class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, i) => (
            <li class="rounded-[20px] border border-brand-border p-7 transition-colors hover:border-brand-accent">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-accent font-bold text-white">
                {i + 1}
              </span>
              <h3 class="mb-2 mt-5 font-heading text-[19px] font-semibold text-brand-dark">
                {step.title}
              </h3>
              <p class="text-[15px] leading-relaxed text-brand-muted">
                {step.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Abordagem -->
  <section
    id="abordagem"
    class="scroll-mt-20 bg-brand-dark px-6 py-20 text-brand-on-dark md:px-11"
  >
    <div
      class="mx-auto grid max-w-content grid-cols-1 items-start gap-12 lg:grid-cols-2"
    >
      <div>
        <p
          class="mb-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-brand-on-dark-accent"
        >
          Abordagem
        </p>
        <h2
          class="mb-5 font-heading text-[38px] font-bold leading-[1.14] tracking-tight text-white"
        >
          Comportamental, prática e baseada em evidências
        </h2>
        <p class="mb-4 text-[17px] leading-relaxed text-brand-on-dark">
          Meu trabalho parte da análise do comportamento: o que acontece antes,
          o que mantém e o que pode ser modificado no contexto. Em vez de
          interpretações abstratas, construímos objetivos observáveis e
          acompanhamos o progresso.
        </p>
        <p class="text-[17px] leading-relaxed text-brand-on-dark">
          Na orientação de pais e no trabalho com pessoas autistas, uso ABA de
          forma ética e respeitosa: o foco é ampliar repertório e autonomia,
          nunca suprimir quem a pessoa é.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          pillars.map((pillar) => (
            <div class="rounded-[18px] border border-brand-on-dark-accent/25 bg-white/[0.07] p-6">
              <h3 class="mb-2 font-heading text-[17px] font-semibold text-white">
                {pillar.title}
              </h3>
              <p class="text-sm leading-relaxed text-brand-on-dark-muted">
                {pillar.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Avaliações -->
  <section
    id="avaliacoes"
    class="scroll-mt-20 bg-brand-light px-6 py-20 md:px-11"
  >
    <div class="mx-auto max-w-content">
      <div class="mb-9 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class={`mb-3.5 ${eyebrow}`}>Avaliações</p>
          <h2 class={sectionTitle}>Quem já fez terapia comigo</h2>
        </div>
        <a
          href={GOOGLE_REVIEWS_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[44px] items-center gap-3 rounded-2xl border border-brand-border bg-white px-6 py-3.5 text-[15px] font-semibold text-brand-primary transition-colors hover:border-brand-accent"
        >
          <span aria-hidden="true" class="tracking-[0.1em] text-brand-star"
            >★★★★★</span
          >
          Avaliações no Google
        </a>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        <figure
          class="flex flex-col gap-4 rounded-[20px] border border-brand-border bg-white p-7"
        >
          <span
            aria-hidden="true"
            class="text-[15px] tracking-[0.12em] text-brand-star"
          >
            ★★★★★
          </span>
          <blockquote class="text-base leading-relaxed text-brand-subtle">
            “Agradeço pelo acolhimento e dedicação com meu filho, a Lauren é uma
            excelente profissional, muito ética e humana.”
          </blockquote>
          <figcaption class="mt-auto text-[13px] text-brand-muted">
            cliente · via Google
          </figcaption>
        </figure>

        <figure
          class="flex flex-col gap-4 rounded-[20px] border border-brand-border bg-white p-7"
        >
          <span
            aria-hidden="true"
            class="text-[15px] tracking-[0.12em] text-brand-star"
          >
            ★★★★★
          </span>
          <blockquote class="text-base leading-relaxed text-brand-subtle">
            “Desde o início do acompanhamento, tenho me sentido acolhido e
            compreendido em minhas demandas e desafios diários.”
          </blockquote>
          <figcaption class="mt-auto text-[13px] text-brand-muted">
            cliente · via Google
          </figcaption>
        </figure>

        <figure
          class="flex flex-col gap-4 rounded-[20px] border border-brand-border bg-white p-7"
        >
          <span
            aria-hidden="true"
            class="text-[15px] tracking-[0.12em] text-brand-star"
          >
            ★★★★★
          </span>
          <blockquote class="text-base leading-relaxed text-brand-subtle">
            “A Lauren tem uma escuta leve, empática e sabe conduzir as conversas
            de um jeito que faz a gente se entender melhor.”
          </blockquote>
          <figcaption class="mt-auto text-[13px] text-brand-muted">
            cliente · via Google
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section id="blog" class="scroll-mt-20 px-6 py-5">
    <!-- blog is disabled for now -->
  </section>
  {
    /** TODO: enable blog section when posts are available */
    posts.length > 10 && (
      <section id="blog" class="scroll-mt-20 px-6 py-20 md:px-11">
        <div class="mx-auto max-w-content">
          <div class="mb-8 flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class={`mb-3.5 ${eyebrow}`}>Blog</p>
              <h2 class={sectionTitle}>Últimos textos</h2>
            </div>
            <a
              href="/blog"
              class="text-[15px] font-semibold text-brand-primary hover:text-brand-primary-hover"
            >
              Ver todos →
            </a>
          </div>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {posts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="flex flex-col overflow-hidden rounded-[20px] border border-brand-border transition-colors hover:border-brand-accent"
              >
                {/* TODO: add a `heroImage` to the blog schema and render it here. */}
                <div class="flex h-[168px] items-center justify-center bg-photo-placeholder">
                  <span class="font-mono text-[11px] text-brand-muted">
                    imagem do post 900×600
                  </span>
                </div>
                <div class="p-6">
                  <p class="mb-2 text-xs text-brand-muted">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {dateFormat.format(post.data.pubDate)}
                    </time>
                    {post.data.tags?.[0] && ` · ${post.data.tags[0]}`}
                  </p>
                  <h3 class="font-heading text-xl font-semibold leading-snug text-brand-dark">
                    {post.data.title}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-20 bg-brand-light px-6 py-20 md:px-11">
    <div
      class="mx-auto grid max-w-content grid-cols-1 items-start gap-12 lg:grid-cols-2"
    >
      <div class="lg:sticky lg:top-6">
        <p class={`mb-3.5 ${eyebrow}`}>FAQ</p>
        <h2 class={`mb-3.5 ${sectionTitle}`}>Perguntas frequentes</h2>
        <p class="max-w-[34ch] text-base leading-relaxed text-brand-body">
          Ficou alguma dúvida que não está aqui? Me pergunte direto no WhatsApp.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        {
          faqs.map((faq) => (
            <details class="group rounded-2xl border border-brand-border bg-white px-6 py-5">
              <summary class="flex list-none items-center justify-between gap-5 text-[17px] font-semibold text-brand-dark [&::-webkit-details-marker]:hidden">
                {faq.q}
                <span
                  aria-hidden="true"
                  class="text-[22px] leading-none text-brand-accent transition-transform duration-200 group-open:rotate-45"
                >
                  +
                </span>
              </summary>
              <p class="mt-4 text-base leading-relaxed text-brand-muted">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contato -->
  <section id="contato" class="scroll-mt-20 bg-brand-light px-6 pb-20 md:px-11">
    <div
      class="relative mx-auto max-w-content overflow-hidden rounded-[28px] bg-brand-accent px-8 py-16 text-center"
    >
      <div
        aria-hidden="true"
        class="absolute -bottom-14 -left-10 h-[220px] w-[220px] rounded-full bg-white/10"
      >
      </div>
      <div
        aria-hidden="true"
        class="absolute -right-8 -top-16 h-[180px] w-[180px] rounded-full bg-brand-card-yellow/25"
      >
      </div>
      <div class="relative">
        <h2
          class="mx-auto max-w-[20ch] font-heading text-cta-title font-bold text-white"
        >
          Agende sua sessão
        </h2>
        <p
          class="mx-auto mt-4 max-w-[50ch] text-[17px] leading-relaxed text-brand-on-dark-bright"
        >
          Me manda uma mensagem contando o que você procura e eu te respondo
          pessoalmente.
        </p>
        <WhatsAppButton variant="inverted" class="mt-7"
          >Falar no WhatsApp</WhatsAppButton
        >
      </div>
    </div>
  </section>
</BaseLayout>

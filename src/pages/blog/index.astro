---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const dateFormat = new Intl.DateTimeFormat('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title="Blog · Lauren Nunes" description="Textos sobre saúde mental e bem-estar.">
  <h1 class="font-heading text-3xl font-bold text-brand-dark">Blog</h1>

  {
    posts.length === 0 ? (
      <p class="mt-6 text-brand-dark/60">Nenhum post publicado ainda.</p>
    ) : (
      <ul class="mt-8 space-y-8">
        {posts.map((post) => (
          <li>
            <article>
              <h2 class="text-2xl font-semibold">
                <a href={`/blog/${post.slug}`} class="hover:text-brand-primary">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-1 text-sm text-brand-dark/60">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormat.format(post.data.pubDate)}
                </time>
              </p>
              <p class="mt-2 text-brand-dark/80">{post.data.description}</p>
              <a
                href={`/blog/${post.slug}`}
                class="mt-2 inline-block text-brand-primary hover:underline"
              >
                Ler mais &rarr;
              </a>
            </article>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

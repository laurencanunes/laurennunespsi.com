---
import { Image } from "astro:assets";
// Poppins, self-hosted. Only the `latin` subset is imported: it covers every
// character the pt-BR copy uses, and `build.inlineStylesheets` puts this CSS in
// every page's head, so the unused latin-ext/devanagari faces are not free.
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-700.css";
// Preloaded below. Importing the files through Vite yields the same hashed URLs
// the @font-face rules above resolve to, so the preload hits the same cache
// entry instead of fetching a second copy.
import poppins400 from "@fontsource/poppins/files/poppins-latin-400-normal.woff2?url";
import poppins700 from "@fontsource/poppins/files/poppins-latin-700-normal.woff2?url";
import "../styles/global.css";
import logo from "../assets/logo-dra-lauren.png";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import {
  CRP,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  SITE_URL,
  WHATSAPP_DISPLAY,
  WHATSAPP_URL,
} from "../consts";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Landing pages render full-bleed sections; content pages get a centred column. */
  wide?: boolean;
  /** Extra JSON-LD to inject into <head>. */
  schema?: unknown;
}

const {
  title = "Lauren Nunes Psicóloga · Terapia online",
  description = "Psicoterapia online em português com Lauren Nunes, psicóloga CRP 06/172464. Terapia comportamental e ABA para adultos, adolescentes e famílias, no Brasil e no exterior. Agende pelo WhatsApp.",
  ogImage,
  wide = false,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;

const nav = [
  { href: "/#sobre", label: "Sobre" },
  { href: "/#demandas", label: "Demandas" },
  { href: "/#como-funciona", label: "Como funciona" },
  // { href: '/blog', label: 'Blog' },
];

// The standalone /sobre page and /blog are not live yet, so every footer link
// points at the matching homepage section — these resolve from any page.
const footerNav = [
  { href: "/#sobre", label: "Sobre mim" },
  { href: "/#demandas", label: "Demandas" },
  // { href: '/blog', label: 'Blog' },
  { href: "/#faq", label: "FAQ" },
];
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      ogImage && (
        <meta property="og:image" content={new URL(ogImage, SITE_URL).href} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    {/* Only the two weights that cover most above-the-fold text: 400 (body) and
        700 (hero h1). 500/600 are nav and eyebrow text, small enough that the
        swap is not worth taking priority from the hero image. `crossorigin` is
        required even same-origin — fonts are fetched in CORS mode, and without
        it the preload misses and the font downloads twice. */}
    <link
      rel="preload"
      href={poppins400}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={poppins700}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      )
    }
  </head>
  <body
    class="flex min-h-screen flex-col bg-white font-sans text-brand-dark antialiased"
  >
    <header class="border-b border-brand-line bg-white px-6 py-4 md:px-11">
      <div
        class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-6"
      >
        <a href="/" class="flex items-center gap-3">
          <Image
            src={logo}
            alt="Logotipo de Lauren Nunes, psicóloga"
            width={42}
            densities={[1, 2]}
          />
          <span class="flex flex-col leading-tight">
            <span class="font-heading text-lg font-semibold text-brand-dark"
              >Lauren Nunes</span
            >
            <span
              class="text-[10px] uppercase tracking-[0.14em] text-brand-muted"
            >
              Psicóloga · {CRP}
            </span>
          </span>
        </a>

        <nav
          aria-label="Principal"
          class="flex flex-wrap items-center gap-6 text-sm font-medium"
        >
          <span class="hidden items-center gap-6 nav:flex">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class="text-brand-subtle hover:text-brand-primary-hover"
                >
                  {item.label}
                </a>
              ))
            }
          </span>
          <WhatsAppButton size="sm">Agendar pelo WhatsApp</WhatsAppButton>
        </nav>
      </div>
    </header>

    {
      wide ? (
        <main class="flex-1">
          <slot />
        </main>
      ) : (
        <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8">
          <slot />
        </main>
      )
    }

    <footer
      class="border-t border-brand-line bg-white px-6 pb-10 pt-14 md:px-11"
    >
      <div
        class="mx-auto flex max-w-content flex-wrap items-start justify-between gap-9"
      >
        <div class="max-w-[280px]">
          <div class="mb-3.5 flex items-center gap-3">
            <Image src={logo} alt="" width={40} densities={[1, 2]} />
            <span class="flex flex-col leading-tight">
              <span
                class="font-heading text-[17px] font-semibold text-brand-dark"
                >Lauren Nunes</span
              >
              <span
                class="text-[10px] uppercase tracking-[0.14em] text-brand-muted"
              >
                Psicóloga · {CRP}
              </span>
            </span>
          </div>
          <p class="text-[13px] leading-relaxed text-brand-muted">
            Psicoterapia online para adultos e famílias, em português, no Brasil
            e no exterior.
          </p>
        </div>

        <nav aria-label="Rodapé" class="flex flex-col gap-2.5 text-sm">
          <span class="text-[11px] uppercase tracking-[0.14em] text-brand-faint"
            >Navegar</span
          >
          {
            footerNav.map((item) => (
              <a
                href={item.href}
                class="text-brand-subtle hover:text-brand-primary-hover"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex flex-col gap-2.5 text-sm">
          <span class="text-[11px] uppercase tracking-[0.14em] text-brand-faint"
            >Contato</span
          >
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener"
            class="text-brand-subtle hover:text-brand-primary-hover"
          >
            WhatsApp {WHATSAPP_DISPLAY}
          </a>
          <a
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener"
            class="text-brand-subtle hover:text-brand-primary-hover"
          >
            Instagram {INSTAGRAM_HANDLE}
          </a>
        </div>

        <p class="max-w-[24ch] text-xs leading-relaxed text-brand-faint">
          &copy; {new Date().getFullYear()} Lauren Nunes. Atendimento conforme a Resolução
          CFP nº 11/2018.
        </p>
      </div>
    </footer>
  </body>
</html>

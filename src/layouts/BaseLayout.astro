---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lauren Nunes · Psicóloga',
  description = 'Lauren Nunes — Psicóloga.',
} = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- TODO: replace with a real favicon in /public (e.g. favicon.svg / favicon.ico) -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-light font-sans text-brand-dark">
    <header class="border-b border-brand-dark/10">
      <nav
        aria-label="Principal"
        class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-4"
      >
        <a href="/" class="font-heading text-lg font-bold text-brand-primary">
          Lauren Nunes
        </a>
        <ul class="flex items-center gap-4">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'hover:text-brand-primary',
                    isActive(item.href) && 'font-semibold text-brand-primary',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-brand-dark/10">
      <div class="mx-auto max-w-3xl px-4 py-6 text-sm text-brand-dark/70">
        <p>&copy; {new Date().getFullYear()} Lauren Nunes · Psicóloga.</p>
      </div>
    </footer>
  </body>
</html>

---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { WHATSAPP_URL } from "../consts";

interface Props {
  /** `solid` fills with brand green, `inverted` is green-on-white for dark panels. */
  variant?: "solid" | "inverted";
  size?: "sm" | "lg";
  /** Overrides the site-wide WhatsApp link — used by referral landing pages. */
  href?: string;
  class?: string;
}

const {
  variant = "solid",
  size = "lg",
  href = WHATSAPP_URL,
  class: className,
} = Astro.props;

const variants = {
  solid: "bg-brand-accent text-white hover:bg-brand-accent-hover",
  inverted: "bg-white text-brand-primary hover:bg-brand-card-yellow",
};

const sizes = {
  sm: "gap-2 rounded-xl px-5 py-3 text-sm",
  lg: "gap-2.5 rounded-2xl px-8 py-4 text-lg",
};
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class:list={[
    "inline-flex min-h-[44px] items-center font-bold transition-colors",
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <WhatsAppIcon size={size === "sm" ? 17 : 21} />
  <slot />
</a>
